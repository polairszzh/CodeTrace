# CodeTrace 部署环境变量（复制为 .env 放在仓库根目录，docker compose 自动读取）

# GitHub Token — 用于 GitHub API 与私有仓库 clone/pull
GITHUB_TOKEN=

# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# API Key 统一鉴权（与前端构建参数保持一致；留空则免鉴权）
# CODETRACE_API_KEY=
# VITE_CODETRACE_API_KEY=

# 对外访问端口（默认 8000）
# PORT=8000

# CORS 允许来源（同源 nginx 代理时无需配置）
# CODETRACE_CORS_ORIGINS=https://your-domain.example
