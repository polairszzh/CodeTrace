# CodeTrace 环境变量配置
# 复制此文件为 .env 并填入你的配置

# GitHub Token — 用于调用 GitHub API（访问私有仓库等）
# 获取方式: gh auth token 或 https://github.com/settings/tokens
# 配置后同时用于 git 私有仓库 clone/pull（认证头注入，不写入 URL/仓库配置）
GITHUB_TOKEN=

# LLM API 配置（以 DeepSeek 为例，可切换其他兼容 OpenAI 接口的厂商）
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# Git 仓库缓存目录
# 默认: Linux /tmp/codetrace，需要在 Windows 上改为本地路径如 G:/tmp/codetrace
# CODETRACE_CACHE=/tmp/codetrace

# 显式指定 git 代理（可选）：需要代理才能访问 GitHub 的用户在这里配一次，
# 跨系统生效，优先级高于系统 git 配置。示例（Clash 默认端口）：
# CODETRACE_GIT_PROXY=http://127.0.0.1:7897
# 未配置时自动继承系统 git 配置；代理连接失败（如未启动）时自动降级直连重试一次；
# 超时场景不重试（避免代理黑洞导致延迟翻倍）。

# 全量 clone 体积阈值（KB），默认 1GB；超过阈值的仓库维持浅克隆
# CODETRACE_CLONE_THRESHOLD_KB=1048576

# 后端监听地址（安全默认仅本机；局域网/远程访问才设为 0.0.0.0）
# CODETRACE_HOST=127.0.0.1

# CORS 允许的前端来源（逗号分隔；部署时按实际前端地址配置）
# CODETRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Key 统一鉴权（部署时设置；留空则本地开发免鉴权）
# 设置后所有 /api 接口要求请求头 X-API-Key 与配置值一致
# 前端构建时用 VITE_CODETRACE_API_KEY 注入同一值
# CODETRACE_API_KEY=
