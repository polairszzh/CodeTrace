# CodeTrace 环境变量配置
# 复制此文件为 .env 并填入你的配置

# GitHub Token — 用于调用 GitHub API（访问私有仓库等）
# 获取方式: gh auth token 或 https://github.com/settings/tokens
GITHUB_TOKEN=

# LLM API 配置（以 DeepSeek 为例，可切换其他兼容 OpenAI 接口的厂商）
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
