# Stage 1: Build frontend
FROM node:22-alpine AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./

# 部署时通过构建参数注入（与后端 CODETRACE_API_KEY 保持一致；留空则免鉴权）
ARG VITE_CODETRACE_API_KEY=
ARG VITE_CODETRACE_API_BASE=/api
ENV VITE_CODETRACE_API_KEY=$VITE_CODETRACE_API_KEY
ENV VITE_CODETRACE_API_BASE=$VITE_CODETRACE_API_BASE

RUN npm run build

# Stage 2: Nginx serving frontend
FROM nginx:alpine
COPY --from=frontend-builder /app/frontend/dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
